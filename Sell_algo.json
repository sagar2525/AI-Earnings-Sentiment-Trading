    {
      "parameters": {
        "jsCode": "// This node calculates the final Profit or Loss (PnL).\n\n// Get the data from the node that provided the live price.\nconst liveData =$('Live Marker Data API').first().json.Price ;\n\n// Get the original trade data from the node that read the Google Sheet.\nconst tradeData = $('Get row(s) in sheet').item.json;\n\n// Get the data from the immediate input (e.g., from the \"SL Hit Signal\" node)\n// so we can pass it through.\nconst inputData = items[0].json;\n\n// Use parseFloat() to ensure all values are treated as numbers for safety.\nconst currentPrice =$('Live Marker Data API').first().json.Price;\nconst buyPrice = $('Get row(s) in sheet').first().json.BuyPrice;\nconst quantity = $('Get row(s) in sheet').first().json.Quantity;\n\n// Calculate the Profit or Loss.\nconst pnl = (currentPrice - buyPrice) * quantity;\n\nconsole.log(`PnL Calculation: (${currentPrice} - ${buyPrice}) * ${quantity} = ${pnl}`);\n\n// Create a new output object that includes the original input data\n// and adds our new PnL calculation.\nconst outputData = {\n  ...inputData, // This copies all existing data (like 'reason', 'row_number')\n  PnL: pnl      // This adds our new PnL value\n};\n\n// Return the complete data for the next node.\nreturn [{\n  json: outputData\n}];"
      },
